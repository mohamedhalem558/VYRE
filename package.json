{
  "name": "vyre",
  "version": "0.1.0",
  "private": true,
  "description": "VYRE - Premium Egyptian Local Clothing Brand E-Commerce Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"WEB,API\" -c \"cyan,magenta\" \"npm run dev --workspace=@vyre/web\" \"npm run dev --workspace=@vyre/api\"",
    "dev:web": "npm run dev --workspace=@vyre/web",
    "dev:api": "npm run dev --workspace=@vyre/api",
    "build": "npm run build --workspace=@vyre/shared && npm run build --workspace=@vyre/api && npm run build --workspace=@vyre/web",
    "build:shared": "npm run build --workspace=@vyre/shared",
    "build:web": "npm run build --workspace=@vyre/web",
    "build:api": "npm run build --workspace=@vyre/api",
    "start": "npm run start --workspace=@vyre/api",
    "start:web": "npm run preview --workspace=@vyre/web",
    "typecheck": "npm run typecheck --workspace=@vyre/shared && npm run typecheck --workspace=@vyre/api && npm run typecheck --workspace=@vyre/web",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@vyre/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@vyre/api",
    "prisma:studio": "npm run prisma:studio --workspace=@vyre/api",
    "prisma:push": "npm run prisma:push --workspace=@vyre/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "keywords": [
    "vyre",
    "ecommerce",
    "react",
    "express",
    "prisma",
    "postgresql",
    "monorepo",
    "egypt",
    "fashion"
  ],
  "author": "VYRE Team",
  "license": "UNLICENSED"
}
