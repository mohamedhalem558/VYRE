{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build --workspace=@vyre/shared && npm run build --workspace=@vyre/api",
  "installCommand": "npm install",
  "outputDirectory": "apps/api/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/api/src/server.ts"
    }
  ]
}
