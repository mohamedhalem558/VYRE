# ─── VYRE API — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | test | production

# ─── URLs ────────────────────────────────────────────────────────────────────
# Development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1

# Production — update these when deploying
# CLIENT_URL=https://your-production-domain.com
# API_URL=https://api.your-production-domain.com/api/v1

# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker:
DATABASE_URL=postgresql://vyre_admin:your_db_password@localhost:5432/vyre_db?schema=public
# Neon PostgreSQL (Production - pooled connection string recommended for serverless):
# DATABASE_URL=postgresql://neondb_owner:npg_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require


# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Development: Leave SMTP_HOST empty → automatically uses Ethereal (free fake SMTP).
#              The Ethereal preview URL is printed in server logs — no inbox needed.
# Production:  Fill in your real SMTP provider credentials below.
#              Works with: Gmail SMTP, SendGrid, Mailtrap, AWS SES, Postmark, etc.
#
# Gmail Setup Note:
# For Gmail, you MUST use a Google App Password (not your personal account password):
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to "App Passwords": https://myaccount.google.com/apppasswords
# 3. Create a password for "VYRE Store" and paste the 16-character code into SMTP_PASS below.

SMTP_HOST=smtp.gmail.com
# SMTP_HOST=smtp.sendgrid.net     # SendGrid example
# SMTP_HOST=live.smtp.mailtrap.io # Mailtrap example

SMTP_PORT=587
# SMTP_PORT=465  # Use 465 for SSL (SMTPS). 587 is standard STARTTLS.

SMTP_USER=your_email@gmail.com

# Both SMTP_PASS and SMTP_PASSWORD are fully supported
SMTP_PASS=your_16_char_app_password
# SMTP_PASSWORD=your_16_char_app_password

# The From address and display name appearing in customer inboxes
EMAIL_FROM=VYRE Store <noreply@vyree.shop>
EMAIL_FROM_NAME=VYRE.

# ─── Reset Password URL ───────────────────────────────────────────────────────
# Optional override for the password reset URL. If omitted, defaults to:
#   {CLIENT_URL}/reset-password
RESET_PASSWORD_URL=https://www.vyree.shop/reset-password

