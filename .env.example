# ==========================================
# VYRE E-Commerce Platform - Environment Variables
# ==========================================

# ------------------------------------------
# Server & Application Configuration
# ------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://vyre_admin:vyre_password_secure@localhost:5432/vyre_db?schema=public

# ------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------
# Minimum 32 characters long
JWT_SECRET=your_super_secret_jwt_access_token_key_min_32_chars_vyre_2026
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_min_32_chars_vyre_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# Client and API URLs (CORS & Frontend connection)
# ------------------------------------------
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# ------------------------------------------
# Email & SMTP Configuration (Nodemailer)
# ------------------------------------------
# In development, leave SMTP_HOST empty to use Ethereal (virtual test inbox)
# In production, specify your real SMTP credentials (e.g. Gmail SMTP, SendGrid, Mailtrap, AWS SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@vyre.store
EMAIL_FROM_NAME=VYRE.

# ------------------------------------------
# Password Reset URL
# ------------------------------------------
# Defaults to ${CLIENT_URL}/reset-password if omitted
RESET_PASSWORD_URL=http://localhost:5173/reset-password
